{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitOrbit",
  "version": "0.5.5",
  "identifier": "ir.sepehra.workspace-monitor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GitOrbit",
        "width": 1180,
        "height": 780,
        "minWidth": 640,
        "minHeight": 480,
        "backgroundColor": "#09090b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "icons/icon.ico": "gitorbit-icon-v4.ico"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "provides": ["workspace-monitor"],
        "conflicts": ["workspace-monitor"],
        "replaces": ["workspace-monitor"]
      }
    },
    "windows": {
      "wix": {
        "upgradeCode": "eb66e790-1edf-5566-bdb9-57a7d205d9cf"
      },
      "nsis": {
        "installerHooks": "windows/gitorbit-migration.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwNzI5QjA0MTVBMDA4MjEKUldRaENLQVZCSnR5a01JUkZ2VE82UGxzTEU2M0tFbGtUck5SSXgvU1EwMVRNblRtWTNqV2luOVgK",
      "endpoints": [
        "https://github.com/sajadjanat/gitorbit/releases/latest/download/latest.json"
      ]
    }
  }
}
